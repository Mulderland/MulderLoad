!define MUI_WELCOMEPAGE_TEXT "\
This $\"BYOF Installer$\" can install Dirt 3 from the original disc image, update it to the Complete Edition, and add:$\r$\n\
- Graphics Remake Mod 2018 (by Hulk)$\r$\n\
- Extreme Graphics Settings (by Talal26)$\r$\n\
- Upscaled Cars Textures (by Talal26)$\r$\n\
- FOV Change Software (by dengo)$\r$\n\
- Super Fast Menus Mod (by Martan)$\r$\n\
- Intro Skip (by Garrett)$\r$\n\
- MulderConfig$\r$\n\
$\r$\n\
WARNING: For legal reasons, this installer doesn't include or download the original disc image. You must provide your own. Tested with EU and HU releases; others may not work.$\r$\n\
$\r$\n\
${TXT_WELCOMEPAGE_MULDERLAND_2}"

!define MUI_FINISHPAGE_RUN "$INSTDIR\MulderConfig.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Run MulderConfig"
!include "..\..\includes\templates\ByofTemplate.nsh"
!include "..\..\includes\tools\7z.nsh"
!include "..\..\includes\tools\XDelta3.nsh"

!insertmacro BYOF_DEFINE "DVD" "$INSTDIR\Images files|*.iso" "6e98c3938d438f5666e9f775017c2021db334291,1aa2127786f910793750814a022adc10bed3f956"
!insertmacro BYOF_PAGE_CREATE
!insertmacro BYOF_WRITE_ENABLE_NEXT_BUTTON

Name "Dirt 3 Complete Edition"
InstallDir "C:\MulderLoad\Dirt 3 Complete Edition"

Section "Dirt 3 Complete Edition (Full Installation)"
	AddSize 14260633
	SetOutPath "$INSTDIR"

	# Extract CABs from DVD image
	!insertmacro 7Z_GET
	!insertmacro 7Z_IMAGE_EXTRACT "$byofPath_DVD" "$INSTDIR\@mulderload\iso" ""
	!insertmacro 7Z_EXTRACT "$INSTDIR\@mulderload\iso\Media1.cab" "$INSTDIR\Media1" "AUTO_DELETE"
	!insertmacro 7Z_EXTRACT "$INSTDIR\@mulderload\iso\Media2.cab" "$INSTDIR\Media2" "AUTO_DELETE"
