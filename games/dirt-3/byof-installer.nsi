	!insertmacro 7Z_EXTRACT "$INSTDIR\@mulderload\iso\Media6.cab" "$INSTDIR\Media6" "AUTO_DELETE"
	!insertmacro 7Z_REMOVE
	RMDir /r "$INSTDIR\@mulderload\iso"

