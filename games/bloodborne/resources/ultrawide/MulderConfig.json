{
  "game": {
    "title": "Bloodborne",
    "originalExe": "Play Bloodborne.exe"
  },
  "optionGroups": [
    {
      "name": "Force ultrawide resolution",
      "type": "radioGroup",
      "radios": [
        { "value": "No" },
        { "value": "21/9 - 2560x1080" },
        { "value": "21/9 - 3440x1440" },
        { "value": "21/9 - 5120x2160" },
        { "value": "32/9 - 3840x1080" },
        { "value": "32/9 - 5120x1440" }
      ]
    },
    {
      "name": "Anti-aliasing",
      "type": "radioGroup",
      "radios": [
        { "value": "No", "disabledWhen": [ { "!Force ultrawide resolution": "No" } ] },
        { "value": "DLAA" },
        { "value": "FSR 3.1" },
        { "value": "FSR 4" },
        { "value": "FSR 4.1.1" }
      ]
    },
    {
      "name": "Misc",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "HUD at screen edges (Ultrawide)", "disabledWhen": [ { "Force ultrawide resolution": "No" } ] }
      ]
    }
  ],
  "actions": {
    "operations": [
      {
        "operation": "removereadonly",
        "files": ["bbport-supermedo\\bbport.ini"]
      },



      {
        "when": [ { "Force ultrawide resolution": "21/9 - 2560x1080" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^output_res.*$",
        "replacement": "output_res=2560x1080"
      },
      {
        "when": [ { "Force ultrawide resolution": "21/9 - 3440x1440" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^output_res.*$",
        "replacement": "output_res=3440x1440"
      },
      {
        "when": [ { "Force ultrawide resolution": "21/9 - 5120x2160" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^output_res.*$",
        "replacement": "output_res=5120x2160"
      },
      {
        "when": [ { "Force ultrawide resolution": "32/9 - 3840x1080" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^output_res.*$",
        "replacement": "output_res=3840x1080"
      },
      {
        "when": [ { "Force ultrawide resolution": "32/9 - 5120x1440" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^output_res.*$",
        "replacement": "output_res=5120x1440"
      },



      {
        "when": [ { "Anti-aliasing": "DLAA" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^upscaler.*$",
        "replacement": "upscaler=dlss"
      },
      {
        "when": [ { "Anti-aliasing": "FSR 3.1" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^upscaler.*$",
        "replacement": "upscaler=fsr3"
      },
      {
        "when": [ { "Anti-aliasing": "FSR 4" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^upscaler.*$",
        "replacement": "upscaler=fsr4"
      },
      {
        "when": [ { "Anti-aliasing": "FSR 4.1.1" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^upscaler.*$",
        "replacement": "upscaler=fsr411"
      },


      
      {
        "when": [ { "!Force ultrawide resolution": "No" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^preset.*$",
        "replacement": "preset=0"
      },
      {
        "when": [ { "!Force ultrawide resolution": "No" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^effect_game_aa.*$",
        "replacement": "effect_game_aa=0"
      },
      {
        "when": [ { "!Force ultrawide resolution": "No" } ],
        "operation": "replaceLine",
        "files": ["bbport-supermedo\\bbport.ini"],
        "pattern": "^live_resolution.*$",
        "replacement": "live_resolution=0"
      },


      
      {
        "when": [ { "!Force ultrawide resolution": "No" } ],
        "operation": "setReadonly",
        "files": ["bbport-supermedo\\bbport.ini"]
      },


      
      {
        "when": [ { "Force ultrawide resolution": "No" } ],
        "operation": "move",
        "source": "patches/Bloodborne_Ultrawide.xml",
        "target": ".MulderConfig/Bloodborne_Ultrawide.xml"
      },
      {
        "when": [ { "!Force ultrawide resolution": "No" } ],
        "operation": "move",
        "source": ".MulderConfig/Bloodborne_Ultrawide.xml",
        "target": "patches/Bloodborne_Ultrawide.xml"
      },



      {
        "operation": "removeLine",
        "files": ["bbport-supermedo\\patches.json"],
        "pattern": "Bloodborne_Ultrawide.xml"
      },
      {
        "when": [ { "Force ultrawide resolution": "21/9 - 2560x1080" } ],
        "operation": "replaceText",
        "files": ["bbport-supermedo\\patches.json"],
        "pattern": "\"enabled\": \\[",
        "replacement": "\"enabled\": [\r\n    \"Bloodborne_Ultrawide.xml/Ultrawide Rendering (21/9) - 2560x1080\""
      },
      {
        "when": [ { "Force ultrawide resolution": "21/9 - 3440x1440" } ],
        "operation": "replaceText",
        "files": ["bbport-supermedo\\patches.json"],
        "pattern": "\"enabled\": \\[",
        "replacement": "\"enabled\": [\r\n    \"Bloodborne_Ultrawide.xml/Ultrawide Rendering (21/9) - 3440x1440\""
      },
      {
        "when": [ { "Force ultrawide resolution": "21/9 - 5120x2160" } ],
        "operation": "replaceText",
        "files": ["bbport-supermedo\\patches.json"],
        "pattern": "\"enabled\": \\[",
        "replacement": "\"enabled\": [\r\n    \"Bloodborne_Ultrawide.xml/Ultrawide Rendering (21/9) - 5120x2160\""
      },
      {
        "when": [ { "Force ultrawide resolution": "32/9 - 3840x1080" } ],
        "operation": "replaceText",
        "files": ["bbport-supermedo\\patches.json"],
        "pattern": "\"enabled\": \\[",
        "replacement": "\"enabled\": [\r\n    \"Bloodborne_Ultrawide.xml/Ultrawide Rendering (32/9) - 3840x1080\""
      },
      {
        "when": [ { "Force ultrawide resolution": "32/9 - 5120x1440" } ],
        "operation": "replaceText",
        "files": ["bbport-supermedo\\patches.json"],
        "pattern": "\"enabled\": \\[",
        "replacement": "\"enabled\": [\r\n    \"Bloodborne_Ultrawide.xml/Ultrawide Rendering (32/9) - 5120x1440\""
      },


      
      {
        "operation": "move",
        "source": "mods/Ultrawide UI (21-9)",
        "target": ".MulderConfig/Ultrawide UI (21-9)"
      },
      {
        "operation": "move",
        "source": "mods/Ultrawide UI (32-9)",
        "target": ".MulderConfig/Ultrawide UI (32-9)"
      },
      {
        "when": [ { "Misc": "HUD at screen edges (Ultrawide)", "*Force ultrawide resolution": "21/9" } ],
        "operation": "move",
        "source": ".MulderConfig/Ultrawide UI (21-9)",
        "target": "mods/Ultrawide UI (21-9)"
      },
      {
        "when": [ { "Misc": "HUD at screen edges (Ultrawide)", "*Force ultrawide resolution": "32/9" } ],
        "operation": "move",
        "source": ".MulderConfig/Ultrawide UI (32-9)",
        "target": "mods/Ultrawide UI (32-9)"
      },



      {
        "operation": "removeLine",
        "files": ["bbport-supermedo\\mods.json"],
        "pattern": "Ultrawide UI"
      },
      {
        "when": [ { "Misc": "HUD at screen edges (Ultrawide)", "*Force ultrawide resolution": "21/9" } ],
        "operation": "replaceText",
        "files": ["bbport-supermedo\\mods.json"],
        "pattern": "  ],\r\n  \"disabled\"",
        "replacement": "    \"Ultrawide UI (21-9)\"\r\n  ],\r\n  \"disabled\""
      },
      {
        "when": [ { "Misc": "HUD at screen edges (Ultrawide)", "*Force ultrawide resolution": "32/9" } ],
        "operation": "replaceText",
        "files": ["bbport-supermedo\\mods.json"],
        "pattern": "  ],\r\n  \"disabled\"",
        "replacement": "    \"Ultrawide UI (32-9)\"\r\n  ],\r\n  \"disabled\""
      }
    ]
  }
}
