{
  "game": {
    "title": "Alpha Protocol",
    "originalExe": "APLauncher.exe"
  },
  "optionGroups": [
    {
      "name": "FOV Increase",
      "type": "radioGroup",
      "radios": [
        { "value": "Default (x1)" },
        { "value": "x1.20" },
        { "value": "x1.40" },
        { "value": "x1.60" },
        { "value": "x1.80" },
        { "value": "Maximum (x2)" }
      ]
    },
    {
      "name": "Graphics Tweaks",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "Ultra graphics preset (set Graphics to High in-game first)" },
        { "value": "Uncap FPS" }
      ]
    },
    {
      "name": "Misc",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "Skip intro videos" },
        { "value": "Skip launcher (Steam only, fix PhysX detection issue)" },
        { "value": "Weapon Accuracy Patch (\"Shooter Experience\" mod)" }
      ]
    }
  ],
  "actions": {
    "launch": [
      {
        "when": [ { "Misc": "Skip launcher (Steam only, fix PhysX detection issue)" } ],
        "exec": { "name": "Binaries\\APGame.exe", "workDir": "Binaries\\" }
      },
      {
        "when": [ { "!Misc": "Skip launcher (Steam only, fix PhysX detection issue)" } ],
        "exec": { "name": "APLauncher_o.exe", "workDir": ".\\" }
      }
    ],
    "operations": [
      {
        "when": [ { "FOV Increase": "Default (x1)" } ],
        "operation": "replaceLine",
        "files": ["Binaries\\AlphaFixer.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor=1.0"
      },
      {
        "when": [ { "FOV Increase": "x1.20" } ],
        "operation": "replaceLine",
        "files": ["Binaries\\AlphaFixer.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor=1.20"
      },
      {
        "when": [ { "FOV Increase": "x1.40" } ],
        "operation": "replaceLine",
        "files": ["Binaries\\AlphaFixer.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor=1.40"
      },
      {
        "when": [ { "FOV Increase": "x1.60" } ],
        "operation": "replaceLine",
        "files": ["Binaries\\AlphaFixer.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor=1.60"
      },
      {
        "when": [ { "FOV Increase": "x1.80" } ],
        "operation": "replaceLine",
        "files": ["Binaries\\AlphaFixer.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor=1.80"
      },
      {
        "when": [ { "FOV Increase": "Maximum (x2)" } ],
        "operation": "replaceLine",
        "files": ["Binaries\\AlphaFixer.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor=2.0"
      },


