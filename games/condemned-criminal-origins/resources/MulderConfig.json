{
  "game": {
    "title": "Condemned: Criminal Origins",
    "originalExe": "Condemned.exe"
  },
  "optionGroups": [
    {
      "name": "Graphical Improvements",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "AI upscaled textures (Neural Origins)" },
        { "value": "DxWrapper's Anti-Aliasing. You must set FSAA=Off",  "disabledWhen": [ { "*Graphical Improvements": "Sikkmod" } ] },
        { "value": "Sikkmod. You must set FSAA=Off, FullscreenFX=Off, SoftShadows=On", "disabledWhen": [ { "*Graphical Improvements": "DxWrapper's Anti-Aliasing" } ] }
      ]
    },
    {
      "name": "Vertical FOV",
      "type": "radioGroup",
      "radios": [
        { "value": "60" },
        { "value": "Default (64.5)" },
        { "value": "70" },
        { "value": "75" },
        { "value": "80" },
        { "value": "85" },
        { "value": "90" }
      ]
    },
    {
      "name": "FPS Limiter",
      "type": "radioGroup",
      "radios": [
        { "value": "60 FPS (recommended for correct stair timing)" },
        { "value": "120 FPS" },
        { "value": "144 FPS" },
        { "value": "Uncapped (warning: breaks ragdoll physics)" }
      ]
    },
    {
      "name": "Window Mode",
      "type": "radioGroup",
      "radios": [
        { "value": "Exclusive Fullscreen" },
        { "value": "Borderless Windowed Fullscreen" },
        { "value": "Windowed" }
      ]
    },
    {
      "name": "HUD Modifications",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "Alternate HUD Colors (recommended for OLED)" },
        { "value": "Toggleable HUD (default key = Caps Lock)" }
      ]
    },
    {
      "name": "Language",
      "type": "radioGroup",
      "radios": [
        { "value": "English" },
        { "value": "French" },
        { "value": "German" },
        { "value": "Italian" },
        { "value": "Spanish" }
      ]
    },
    {
      "name": "Misc",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "Restore EAX Sound with DSOAL + OpenAL Soft" },
        { "value": "Skip Intro Videos" }
      ]
    }
  ],
  "actions": {
    "operations": [
      {
        "when": [ { "*Graphical Improvements": "Neural Origins" } ],
        "operation": "move",
        "source": ".MulderConfig\\NeuralOrigins\\Game\\CondemnedN.Arch00",
        "target": "Game\\CondemnedN.Arch00"
      },
      {
        "when": [ { "!*Graphical Improvements": "Neural Origins" } ],
        "operation": "move",
        "source": "Game\\CondemnedN.Arch00",
        "target": ".MulderConfig\\NeuralOrigins\\Game\\CondemnedN.Arch00"
      },



      {
        "when": [ { "*Graphical Improvements": "DxWrapper's Anti-Aliasing" } ],
        "operation": "replaceLine",
        "files": ["dxwrapper.ini"],
        "pattern": "^AntiAliasing.*$",
        "replacement": "AntiAliasing               = 1"
      },
      {
        "when": [ { "!*Graphical Improvements": "DxWrapper's Anti-Aliasing" } ],
        "operation": "replaceLine",
        "files": ["dxwrapper.ini"],
        "pattern": "^AntiAliasing.*$",
        "replacement": "AntiAliasing               = 0"
      },



      {
        "when": [ { "*Graphical Improvements": "Sikkmod" } ],
        "operation": "move",
        "source": ".MulderConfig\\Sikkmod\\Game\\CondemnedS.Arch00",
        "target": "Game\\CondemnedS.Arch00"
      },
      {
        "when": [ { "!*Graphical Improvements": "Sikkmod" } ],
        "operation": "move",
        "source": "Game\\CondemnedS.Arch00",
        "target": ".MulderConfig\\Sikkmod\\Game\\CondemnedS.Arch00"
      },


      
      {
        "when": [ ],
        "operation": "removeLine",
        "files": ["autoexec.cfg"],
        "pattern": "^\"FovY\".*$"
      },
      {
        "when": [ { "Vertical FOV": "60" } ],
        "operation": "replaceText",
        "files": ["autoexec.cfg"],
        "search": "\"NearZ\"",
        "replacement": "\"FovY\" \"60.0\"\n\"NearZ\""
      },
      {
        "when": [ { "Vertical FOV": "70" } ],
        "operation": "replaceText",
        "files": ["autoexec.cfg"],
        "search": "\"NearZ\"",
        "replacement": "\"FovY\" \"70.0\"\n\"NearZ\""
      },
      {
        "when": [ { "Vertical FOV": "75" } ],
        "operation": "replaceText",
        "files": ["autoexec.cfg"],
        "search": "\"NearZ\"",
        "replacement": "\"FovY\" \"75.0\"\n\"NearZ\""
      },
      {
        "when": [ { "Vertical FOV": "80" } ],
        "operation": "replaceText",
        "files": ["autoexec.cfg"],
        "search": "\"NearZ\"",
        "replacement": "\"FovY\" \"80.0\"\n\"NearZ\""
      },
      {
        "when": [ { "Vertical FOV": "85" } ],
        "operation": "replaceText",
        "files": ["autoexec.cfg"],
        "search": "\"NearZ\"",
        "replacement": "\"FovY\" \"85.0\"\n\"NearZ\""
      },
      {
        "when": [ { "Vertical FOV": "90" } ],
        "operation": "replaceText",
        "files": ["autoexec.cfg"],
        "search": "\"NearZ\"",
        "replacement": "\"FovY\" \"90.0\"\n\"NearZ\""
      },



      {
        "when": [ { "*FPS Limiter": "60 FPS" } ],
        "operation": "replaceLine",
        "files": ["dxwrapper.ini"],
        "pattern": "^LimitPerFrameFPS.*$",
        "replacement": "LimitPerFrameFPS           = 60"
      },
      {
        "when": [ { "FPS Limiter": "120 FPS" } ],
        "operation": "replaceLine",
        "files": ["dxwrapper.ini"],
        "pattern": "^LimitPerFrameFPS.*$",
        "replacement": "LimitPerFrameFPS           = 120"
      },
      {
        "when": [ { "FPS Limiter": "144 FPS" } ],
        "operation": "replaceLine",
        "files": ["dxwrapper.ini"],
        "pattern": "^LimitPerFrameFPS.*$",
        "replacement": "LimitPerFrameFPS           = 144"
      },
      {
        "when": [ { "*FPS Limiter": "Uncapped" } ],
        "operation": "replaceLine",
        "files": ["dxwrapper.ini"],
        "pattern": "^LimitPerFrameFPS.*$",
        "replacement": "LimitPerFrameFPS           = 0"
      },

      
      
      {
        "when": [ ],
        "operation": "removeLine",
        "files": ["autoexec.cfg"],
        "pattern": "^\"Windowed\".*$"
      },
      {
        "when": [ { "!Window Mode": "Exclusive Fullscreen" } ],
        "operation": "replaceText",
        "files": ["autoexec.cfg"],
        "search": "\"GPUSafeLevel\"",
        "replacement": "\"Windowed\" \"1\"\n\"GPUSafeLevel\""
      },
      {
        "when": [ { "Window Mode": "Borderless Windowed Fullscreen" } ],
        "operation": "replaceText",
        "files": ["scripts\\Condemned.WidescreenFix.ini"],
        "search": "BorderlessWindowed = 0",
        "replacement": "BorderlessWindowed = 1"
      },
      {
        "when": [ { "!Window Mode": "Borderless Windowed Fullscreen" } ],
        "operation": "replaceText",
        "files": ["scripts\\Condemned.WidescreenFix.ini"],
        "search": "BorderlessWindowed = 1",
        "replacement": "BorderlessWindowed = 0"
      },



      {
        "when": [ { "*HUD Modifications": "Alternate HUD Colors" } ],
        "operation": "move",
        "source": ".MulderConfig\\OLEDAlternateHUDColors\\Game\\CondemnedO.Arch00",
        "target": "Game\\CondemnedO.Arch00"
      },
      {
        "when": [ { "!*HUD Modifications": "Alternate HUD Colors" } ],
        "operation": "move",
        "source": "Game\\CondemnedO.Arch00",
        "target": ".MulderConfig\\OLEDAlternateHUDColors\\Game\\CondemnedO.Arch00"
      },



      {
