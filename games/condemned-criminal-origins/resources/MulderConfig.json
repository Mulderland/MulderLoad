        "target": "scripts\\ReShade.ini"
      },
      {
        "when": [ { "*HUD Modifications": "Toggleable HUD" } ],
        "operation": "move",
        "source": ".MulderConfig\\ToggleHUD\\scripts\\ShaderToggler.addon",
        "target": "scripts\\ShaderToggler.addon"
      },
      {
        "when": [ { "!*HUD Modifications": "Toggleable HUD" } ],
        "operation": "move",
        "source": "ShaderToggler.ini",
        "target": ".MulderConfig\\ToggleHUD\\ShaderToggler.ini"
      },
      {
        "when": [ { "!*HUD Modifications": "Toggleable HUD" } ],
        "operation": "move",
        "source": "scripts\\reshade-shaders",
        "target": ".MulderConfig\\ToggleHUD\\scripts\\reshade-shaders"
      },
      {
        "when": [ { "!*HUD Modifications": "Toggleable HUD" } ],
        "operation": "move",
        "source": "scripts\\d3d9.asi",
        "target": ".MulderConfig\\ToggleHUD\\scripts\\d3d9.asi"
      },
      {
        "when": [ { "!*HUD Modifications": "Toggleable HUD" } ],
        "operation": "move",
        "source": "scripts\\ReShade.ini",
        "target": ".MulderConfig\\ToggleHUD\\scripts\\ReShade.ini"
      },
      {
        "when": [ { "!*HUD Modifications": "Toggleable HUD" } ],
        "operation": "move",
        "source": "scripts\\ShaderToggler.addon",
        "target": ".MulderConfig\\ToggleHUD\\scripts\\ShaderToggler.addon"
      },



