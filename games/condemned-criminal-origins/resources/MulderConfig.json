        "operation": "move",
        "source": ".MulderConfig\\ToggleHUD\\ShaderToggler.ini",
        "target": "ShaderToggler.ini"
      },
      {
        "when": [ { "*HUD Modifications": "Toggleable HUD" } ],
        "operation": "move",
        "source": ".MulderConfig\\ToggleHUD\\scripts\\reshade-shaders",
        "target": "scripts\\reshade-shaders"
      },
      {
        "when": [ { "*HUD Modifications": "Toggleable HUD" } ],
