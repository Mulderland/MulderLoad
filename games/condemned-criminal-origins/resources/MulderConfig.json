      {
        "when": [ ],
        "operation": "removeLine",
        "files": ["autoexec.cfg"],
        "pattern": "^\"DisableMovies\".*$"
      },
      {
        "when": [ { "Misc": "Skip Intro Videos" } ],
        "operation": "replaceText",
        "files": ["autoexec.cfg"],
        "search": "\"ConsoleRight\"",
