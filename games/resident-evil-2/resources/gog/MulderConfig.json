{
  "game": {
    "title": "Resident Evil 2 (GOG)",
    "originalExe": "BH2Launcher.exe"
  },
  "optionGroups": [
    {
      "name": "Misc",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "Enable dgVoodoo2" },
        { "value": "Enable HD textures" },
        { "value": "Enable Modern Controls Plus" }
      ]
    },
    {
      "name": "MSAA Anti-Aliasing",
      "type": "radioGroup",
      "radios": [
        { "value": "Off" },
        { "value": "2x", "disabledWhen": [ { "!Misc": "Enable dgVoodoo2" } ] },
        { "value": "4x", "disabledWhen": [ { "!Misc": "Enable dgVoodoo2" } ] },
        { "value": "8x", "disabledWhen": [ { "!Misc": "Enable dgVoodoo2" } ] }
      ]
    }
  ],
  "actions": {
    "operations": [
      {
        "when": [ { "Misc": "Enable dgVoodoo2" } ],
        "operation": "rename",
        "source": "_re2_DDraw.dll.bak",
        "target": "re2_DDraw.dll"
      },
      {
        "when": [ { "Misc": "Enable dgVoodoo2" } ],
        "operation": "rename",
        "source": "_D3DImm.dll.bak",
        "target": "D3DImm.dll"
      },
      {
        "when": [ { "!Misc": "Enable dgVoodoo2" } ],
        "operation": "rename",
        "source": "re2_DDraw.dll",
        "target": "_re2_DDraw.dll.bak"
      },
      {
        "when": [ { "!Misc": "Enable dgVoodoo2" } ],
        "operation": "rename",
        "source": "D3DImm.dll",
        "target": "_D3DImm.dll.bak"
      },
      {
        "when": [ { "Misc": "Enable HD textures" } ],
        "operation": "rename",
        "source": "_bio2hd.asi.bak",
        "target": "bio2hd.asi"
      },
      {
        "when": [ { "!Misc": "Enable HD textures" } ],
        "operation": "rename",
        "source": "bio2hd.asi",
        "target": "_bio2hd.asi.bak"
      },
      {
        "when": [ { "Misc": "Enable Modern Controls Plus" } ],
        "operation": "rename",
        "source": ".MulderConfig\\ModernControlsPlus\\ModernControlsPlus.dll",
        "target": "ModernControlsPlus.asi"
      },
      {
        "when": [ { "!Misc": "Enable Modern Controls Plus" } ],
        "operation": "rename",
        "source": "ModernControlsPlus.asi",
        "target": ".MulderConfig\\ModernControlsPlus\\ModernControlsPlus.dll"
      },
      {
        "when": [ { "MSAA Anti-Aliasing": "Off" } ],
        "operation": "replaceLine",
        "files": ["dgVoodoo.conf"],
        "pattern": "^Antialiasing                        =.*$",
        "replacement": "Antialiasing                        = appdriven"
      },
      {
        "when": [ { "MSAA Anti-Aliasing": "2x" } ],
        "operation": "replaceLine",
        "files": ["dgVoodoo.conf"],
        "pattern": "^Antialiasing                        =.*$",
        "replacement": "Antialiasing                        = 2x"
      },
      {
        "when": [ { "MSAA Anti-Aliasing": "4x" } ],
        "operation": "replaceLine",
        "files": ["dgVoodoo.conf"],
        "pattern": "^Antialiasing                        =.*$",
        "replacement": "Antialiasing                        = 4x"
      },
      {
        "when": [ { "MSAA Anti-Aliasing": "8x" } ],
        "operation": "replaceLine",
        "files": ["dgVoodoo.conf"],
        "pattern": "^Antialiasing                        =.*$",
        "replacement": "Antialiasing                        = 8x"
      }
    ]
  }
}
