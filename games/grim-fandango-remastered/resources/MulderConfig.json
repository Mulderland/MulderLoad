{
  "game": {
    "title": "Grim Fandango Remastered",
    "originalExe": "GrimFandango.exe"
  },
  "optionGroups": [
    {
      "name": "GrimMod",
      "type": "checkboxGroup",
      "checkboxes": [{ "value": "Enabled" }]
    },
    {
      "name": "Graphical enhancements",
      "type": "checkboxGroup",
      "checkboxes": [
        {
          "value": "Forced VSync",
          "disabledWhen": [{ "!GrimMod": "Enabled" }]
        },
        {
          "value": "HQ Backgrounds",
          "disabledWhen": [{ "!GrimMod": "Enabled" }]
        }
      ]
    },
    {
      "name": "Unofficial translation",
      "type": "radioGroup",
      "radios": [
        { "value": "None" },
        { "value": "Czech" },
        { "value": "Romanian" },
        { "value": "Russian" }
      ]
    },
    {
      "name": "Misc",
      "type": "checkboxGroup",
      "checkboxes": [{ "value": "Skip intro logo" }]
    }
  ],
  "actions": {
    "operations": [
      {
        "when": [{ "!GrimMod": "Enabled" }],
        "operation": "move",
        "source": "glu32.dll",
        "target": ".MulderConfig\\grimmod\\glu32.dll"
      },
      {
        "when": [{ "GrimMod": "Enabled" }],
        "operation": "move",
        "source": ".MulderConfig\\grimmod\\glu32.dll",
        "target": "glu32.dll"
      },

      {
        "when": [{ "Graphical enhancements": "Forced VSync" }],
        "operation": "replaceLine",
        "files": ["grimmod.toml"],
        "pattern": "^vsync.*$",
        "replacement": "vsync = true"
      },
      {
        "when": [{ "!Graphical enhancements": "Forced VSync" }],
        "operation": "replaceLine",
        "files": ["grimmod.toml"],
        "pattern": "^vsync.*$",
        "replacement": "vsync = false"
      },

      {
        "when": [{ "Graphical enhancements": "HQ Backgrounds" }],
        "operation": "replaceLine",
        "files": ["grimmod.toml"],
        "pattern": "^hq_assets.*$",
        "replacement": "hq_assets = true"
      },
      {
        "when": [{ "!Graphical enhancements": "HQ Backgrounds" }],
        "operation": "replaceLine",
        "files": ["grimmod.toml"],
        "pattern": "^hq_assets.*$",
        "replacement": "hq_assets = false"
      },

