      },
      {
        "when": [ { "FPS Unlocker": "240 FPS" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\scripts\\MGSFPSUnlock.ini"],
        "pattern": "^TargetFrameRate.*$",
