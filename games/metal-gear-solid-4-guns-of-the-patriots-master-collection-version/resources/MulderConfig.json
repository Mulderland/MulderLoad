      },
      {
        "when": [ { "*Ultrawide Support": "21/9", "FOV Modifier": "Highest (+20%)" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
        "replacement": "FOVMultiplier=1.44"
      },


      {
        "when": [ { "*Ultrawide Support": "32/9", "FOV Modifier": "Lowest (-20%)" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
