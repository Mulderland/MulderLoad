        "operation": "move",
        "source": "MGS4\\scripts\\MGSFPSUnlock.asi",
        "target": ".MulderConfig\\MGSFPSUnlock\\MGS4\\scripts\\MGSFPSUnlock.asi"
      },
      {
        "when": [ { "!FPS Unlocker": "No (60 FPS)" } ],
        "operation": "move",
        "source": ".MulderConfig\\MGSFPSUnlock\\MGS4\\scripts\\MGSFPSUnlock.asi",
        "target": "MGS4\\scripts\\MGSFPSUnlock.asi"
      },
      {
        "when": [ { "FPS Unlocker": "120 FPS" } ],
