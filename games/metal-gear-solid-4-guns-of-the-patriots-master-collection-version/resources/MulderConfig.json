        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
        "replacement": "FOVMultiplier=1.0"
      },
      {
        "when": [ { "Ultrawide Support": "No (default)", "FOV Modifier": "Higher (+10%)" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
        "replacement": "FOVMultiplier=1.1"
      },
      {
        "when": [ { "Ultrawide Support": "No (default)", "FOV Modifier": "Highest (+20%)" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
        "replacement": "FOVMultiplier=1.2"
      },



      {
        "when": [ { "*Ultrawide Support": "21/9", "FOV Modifier": "Lowest (-20%)" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
        "replacement": "FOVMultiplier=0.96"
      },
      {
        "when": [ { "*Ultrawide Support": "21/9", "FOV Modifier": "Lower (-10%)" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
        "replacement": "FOVMultiplier=1.08"
      },
      {
        "when": [ { "*Ultrawide Support": "21/9", "FOV Modifier": "Default" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
        "replacement": "FOVMultiplier=1.2"
      },
      {
        "when": [ { "*Ultrawide Support": "21/9", "FOV Modifier": "Higher (+10%)" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
