{
  "game": {
    "title": "Metal Gear Solid 4: Guns of the Patriots (Master Collection Version)",
    "originalExe": "mgs4.exe"
  },
  "optionGroups": [
    {
      "name": "Ultrawide Support",
      "type": "radioGroup",
      "radios": [
        { "value": "No (default)" },
        { "value": "21/9 (2560x1080)" },
        { "value": "21/9 (3440x1440)" },
        { "value": "21/9 (3840x1600)" },
        { "value": "32/9 (3840x1080)" },
        { "value": "32/9 (5120x1440)" },
        { "value": "32/9 (7680x2160)" }
      ]
    },
    {
      "name": "FOV Modifier",
      "type": "radioGroup",
      "radios": [
        { "value": "Lowest (-20%)" },
        { "value": "Lower (-10%)" },
        { "value": "Default" },
        { "value": "Higher (+10%)" },
        { "value": "Highest (+20%)" }
      ]
    },
    {
      "name": "FPS Unlocker",
      "type": "radioGroup",
      "radios": [
        { "value": "No (60 FPS)" },
        { "value": "120 FPS" },
        { "value": "144 FPS" },
        { "value": "165 FPS" },
        { "value": "240 FPS" }
      ]
    },
    {
      "name": "Misc",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "Stats Overlay (Warning: dx11 only, crashes on dx12)" },
        { "value": "Ultrawide Centered HUD", "disabledWhen": [ { "Ultrawide Support": "No (default)" } ] }
      ]
    }
  ],
  "actions": {
    "operations": [
      {
        "when": [ ],
        "operation": "move",
        "source": "MGS4\\scripts\\MGS4Ultra120.asi",
        "target": ".MulderConfig\\MGS4Ultra120\\MGS4\\scripts\\MGS4Ultra120.asi"
      },
      {
        "when": [ { "!Ultrawide Support": "No (default)" }, { "!FOV Modifier": "Default" } ],
        "operation": "move",
        "source": ".MulderConfig\\MGS4Ultra120\\MGS4\\scripts\\MGS4Ultra120.asi",
        "target": "MGS4\\scripts\\MGS4Ultra120.asi"
      },



      {
        "when": [ { "*Ultrawide Support": "2560x" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Width=.*$",
        "replacement": "Width=2560"
      },
      {
        "when": [ { "*Ultrawide Support": "3440x" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Width=.*$",
        "replacement": "Width=3440"
      },
      {
        "when": [ { "*Ultrawide Support": "3840x" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Width=.*$",
        "replacement": "Width=3840"
      },
      {
        "when": [ { "*Ultrawide Support": "5120x" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Width=.*$",
        "replacement": "Width=5120"
      },
      {
        "when": [ { "*Ultrawide Support": "7680x" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Width=.*$",
        "replacement": "Width=7680"
      },
      {
        "when": [ { "*Ultrawide Support": "x1080" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Height=.*$",
        "replacement": "Height=1080"
      },
      {
        "when": [ { "*Ultrawide Support": "x1440" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Height=.*$",
        "replacement": "Height=1440"
      },
      {
        "when": [ { "*Ultrawide Support": "x1600" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Height=.*$",
        "replacement": "Height=1600"
      },
      {
        "when": [ { "*Ultrawide Support": "x2160" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^Height=.*$",
        "replacement": "Height=2160"
      },


      
      {
        "when": [ { "Ultrawide Support": "No (default)", "FOV Modifier": "Lowest (-20%)" } ],
        "operation": "replaceLine",
        "files": ["MGS4\\mgs4_ultrawide.ini"],
        "pattern": "^FOVMultiplier=.*$",
        "replacement": "FOVMultiplier=0.8"
