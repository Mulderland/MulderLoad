{
  "game": {
    "title": "Max Payne",
    "originalExe": "maxpayne.exe"
  },
  "optionGroups": [
    {
      "name": "Executable",
      "type": "radioGroup",
      "radios": [
        { "value": "Default executable" },
        { "value": "4GB Patched executable (Steam only)" }
      ]
    },
    {
      "name": "Improvements",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "New Weapons sounds" },
        { "value": "Upscaled Textures (requires Detail Textures = Medium)", "disabledWhen": [{ "!Executable": "4GB Patched executable (Steam only)" }] }
      ]
    },
    {
      "name": "Translation patches (texts only)",
      "type": "radioGroup",
      "radios": [
        { "value": "None (default)" },
        { "value": "French patch" },
        { "value": "Italian patch" },
        { "value": "Polish patch" },
        { "value": "Portuguese patch (Brazil)" },
        { "value": "Russian patch" },
        { "value": "Spanish patch" }
      ]
    }
  ],
  "actions": {
    "operations": [
      {
        "when": [ { "Executable": "Default executable" } ],
        "operation": "copy",
        "source": "_maxpayne.exe.bak",
        "target": "maxpayne.exe"
      },
      {
        "when": [ { "Executable": "4GB Patched executable (Steam only)" } ],
        "operation": "copy",
        "source": "_maxpayne_4gb.exe.bak",
        "target": "maxpayne.exe"
      },
      {
        "when": [ { "Improvements": "New Weapons sounds" } ],
        "operation": "copy",
        "source": "_x_data_weapons.ras.bak",
        "target": "x_data.ras"
      },
      {
        "when": [ { "!Improvements": "New Weapons sounds" } ],
        "operation": "copy",
        "source": "_x_data.ras.bak",
        "target": "x_data.ras"
      },
      {
        "when": [ { "*Improvements": "Upscaled Textures" } ],
        "operation": "rename",
        "source": "data\\_database",
        "target": "data\\database"
      },
      {
        "when": [ { "*Improvements": "Upscaled Textures" } ],
        "operation": "rename",
        "source": "data\\_graphicnovel",
        "target": "data\\graphicnovel"
      },
      {
        "when": [ { "*Improvements": "Upscaled Textures" } ],
        "operation": "rename",
        "source": "data\\_hud",
        "target": "data\\hud"
      },
      {
        "when": [ { "!*Improvements": "Upscaled Textures" } ],
        "operation": "rename",
        "source": "data\\database",
        "target": "data\\_database"
      },
      {
        "when": [ { "!*Improvements": "Upscaled Textures" } ],
        "operation": "rename",
        "source": "data\\graphicnovel",
        "target": "data\\_graphicnovel"
      },
      {
        "when": [ { "!*Improvements": "Upscaled Textures" } ],
        "operation": "rename",
        "source": "data\\hud",
        "target": "data\\_hud"
      },
      {
        "when": [ { "Translation patches (texts only)": "French patch" } ],
        "operation": "rename",
        "source": "_MP1_TextOnly_fr-FR.ras.bak",
        "target": "MP1_TextOnly_fr-FR.ras"
      },
      {
