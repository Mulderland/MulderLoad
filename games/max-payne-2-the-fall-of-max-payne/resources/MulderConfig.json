{
  "game": {
    "title": "Max Payne 2: The Fall of Max Payne",
    "originalExe": "maxpayne2.exe"
  },
  "optionGroups": [
    {
      "name": "Graphical Improvements",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "DxWrapper Anti-Aliasing (WARNING: you must disable in-game AA)" },
        { "value": "HUD at screen edges (Ultrawide)" },
        { "value": "Xbox Rain Droplets" }
      ]
    },
    {
      "name": "FOV Modifier",
      "type": "radioGroup",
      "radios": [
        { "value": "Lowest (-20%)" },
        { "value": "Lower (-10%)" },
        { "value": "Default" },
        { "value": "Higher (+10%)" },
        { "value": "Highest (+20%)" }
      ]
    },
    {
      "name": "Audio Language",
      "type": "radioGroup",
      "radios": [
        { "value": "English" },
        { "value": "German" },
        { "value": "Italian" },
        { "value": "Russian" },
        { "value": "Spanish" }
      ]
    },
    {
      "name": "Text Language",
      "type": "radioGroup",
      "radios": [
        { "value": "English" },
        { "value": "French" },
        { "value": "German" },
        { "value": "Italian" },
        { "value": "Polish" },
        { "value": "Russian" },
        { "value": "Spanish" }
      ]
    },
    {
      "name": "Sound Fix",
      "type": "radioGroup",
      "radios": [
        { "value": "None (original)" },
        { "value": "DSOAL + OpenAL Soft (recommended for audio issues)" },
        { "value": "IndirectSound (compatibility)" }
      ]
    },
    {
      "name": "Misc",
      "type": "checkboxGroup",
      "checkboxes": [
        { "value": "Audio Mix Tweaks (if dialogue is too quiet)" },
        { "value": "Weapon Accuracy Patch" }
      ]
    }
  ],
  "actions": {
    "operations": [
      {
        "when": [ { "*Graphical Improvements": "DxWrapper Anti-Aliasing" } ],
        "operation": "replaceLine",
        "files": ["dxwrapper.ini"],
        "pattern": "^AntiAliasing.*$",
        "replacement": "AntiAliasing               = 1"
      },
      {
        "when": [ { "!*Graphical Improvements": "DxWrapper Anti-Aliasing" } ],
        "operation": "replaceLine",
        "files": ["dxwrapper.ini"],
        "pattern": "^AntiAliasing.*$",
        "replacement": "AntiAliasing               = 0"
      },
      {
        "when": [ { "*Graphical Improvements": "HUD at screen edges (Ultrawide)" } ],
        "operation": "replaceLine",
        "files": ["scripts\\MaxPayne2.WidescreenFix.ini"],
        "pattern": "^WidescreenHudOffset.*$",
        "replacement": "WidescreenHudOffset = 250.0 // 100.0 is the default offset for 16:9. For lower aspect ratios adjusted automatically, for higher you may change it manually."
      },
      {
        "when": [ { "!*Graphical Improvements": "HUD at screen edges (Ultrawide)" } ],
        "operation": "replaceLine",
        "files": ["scripts\\MaxPayne2.WidescreenFix.ini"],
        "pattern": "^WidescreenHudOffset.*$",
        "replacement": "WidescreenHudOffset = 100.0 // This is the default offset for 16:9. For lower aspect ratios adjusted automatically, for higher you may change it manually."
      },
      {
        "when": [ { "Graphical Improvements": "Xbox Rain Droplets" } ],
        "operation": "move",
        "source": ".MulderConfig\\xbox_rain_droplets\\scripts\\MaxPayne2.XboxRainDroplets.asi",
        "target": "scripts\\MaxPayne2.XboxRainDroplets.asi"
      },
      {
        "when": [ { "Graphical Improvements": "Xbox Rain Droplets" } ],
        "operation": "move",
        "source": ".MulderConfig\\xbox_rain_droplets\\scripts\\MaxPayne2.XboxRainDroplets.ini",
        "target": "scripts\\MaxPayne2.XboxRainDroplets.ini"
      },
      {
        "when": [ { "!Graphical Improvements": "Xbox Rain Droplets" } ],
        "operation": "move",
        "source": "scripts\\MaxPayne2.XboxRainDroplets.asi",
        "target": ".MulderConfig\\xbox_rain_droplets\\scripts\\MaxPayne2.XboxRainDroplets.asi"
      },
      {
        "when": [ { "!Graphical Improvements": "Xbox Rain Droplets" } ],
        "operation": "move",
        "source": "scripts\\MaxPayne2.XboxRainDroplets.ini",
        "target": ".MulderConfig\\xbox_rain_droplets\\scripts\\MaxPayne2.XboxRainDroplets.ini"
      },



      {
        "when": [ { "FOV Modifier": "Lowest (-20%)" } ],
        "operation": "replaceLine",
        "files": ["scripts\\MaxPayne2.WidescreenFix.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor = 0.8"
      },
      {
        "when": [ { "FOV Modifier": "Lower (-10%)" } ],
        "operation": "replaceLine",
        "files": ["scripts\\MaxPayne2.WidescreenFix.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor = 0.9"
      },
      {
        "when": [ { "FOV Modifier": "Default" } ],
        "operation": "replaceLine",
        "files": ["scripts\\MaxPayne2.WidescreenFix.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor = 1.0"
      },
      {
        "when": [ { "FOV Modifier": "Higher (+10%)" } ],
        "operation": "replaceLine",
        "files": ["scripts\\MaxPayne2.WidescreenFix.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor = 1.1"
      },
      {
        "when": [ { "FOV Modifier": "Highest (+20%)" } ],
        "operation": "replaceLine",
        "files": ["scripts\\MaxPayne2.WidescreenFix.ini"],
        "pattern": "^FOVFactor.*$",
        "replacement": "FOVFactor = 1.2"
      },



